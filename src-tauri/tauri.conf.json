{
  "$schema": "https://tauri.app",
  "productName": "ripgrep-all-gui",
  "identifier": "ripgrep-all-gui",
  "version": "1.6.1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ripgrep-all-gui",
        "width": 1600,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 800,
        "theme": "Dark",
        "resizable": true,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}